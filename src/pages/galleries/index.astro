---
import Base from "~/layouts/Base.astro";
import GalleryCard from "~/components/GalleryCard.astro";
import { getPublishedGalleries } from "~/lib/content";

const galleries = await getPublishedGalleries();
---
<Base title="Galleries" description="Browse all photography galleries by Courtney Anton.">
  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16 md:py-24">
    <header class="mb-12 md:mb-16 max-w-2xl">
      <p class="text-sm uppercase tracking-widest text-rust mb-3">Portfolio</p>
      <h1 class="font-display text-5xl md:text-6xl mb-6">Galleries</h1>
      <p class="text-bark-soft text-lg leading-relaxed">
        Photography is all about holding life still for just that one moment. Browse a few of the moments
        I've been honored to capture for families across Maryland, Pennsylvania, and Washington DC.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {galleries.map((gallery) => (
        <GalleryCard
          title={gallery.data.title}
          href={`/galleries/${gallery.data.slug}`}
          coverImage={gallery.data.coverImage}
          tagline={gallery.data.tagline}
        />
      ))}
    </div>
  </section>
</Base>
