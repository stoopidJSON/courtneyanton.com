---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import Lightbox from "~/components/Lightbox.astro";
import { getPublishedGalleries } from "~/lib/content";

export async function getStaticPaths() {
  const galleries = await getPublishedGalleries();
  return galleries.map((g) => ({
    params: { slug: g.data.slug },
    props: { gallery: g },
  }));
}

const { gallery } = Astro.props;
const { title, tagline, images } = gallery.data;
const { Content } = await render(gallery);
---
<Base title={title} description={tagline ?? `${title} photography by Courtney Anton`}>
  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-16 md:py-24">
    <header class="mb-12 max-w-2xl">
      <a href="/galleries" class="text-xs uppercase tracking-widest text-bark-soft hover:text-rust transition-colors">
        ← All galleries
      </a>
      <h1 class="font-display text-5xl md:text-6xl mt-4 mb-3">{title}</h1>
      {tagline && <p class="text-rust uppercase tracking-widest text-sm mb-4">{tagline}</p>}
      <div class="text-bark-soft text-lg leading-relaxed">
        <Content />
      </div>
    </header>

    {images.length === 0 ? (
      <p class="text-bark-soft italic">No photos in this gallery yet.</p>
    ) : (
      <div class="gallery-grid" data-lightbox-group>
        {images.map((img, i) => (
          <button
            type="button"
            class="gallery-grid__item block w-full mb-4 overflow-hidden bg-bark/5 cursor-zoom-in group"
            data-lightbox-trigger
            data-src={img.image}
            data-alt={img.alt}
            data-caption={img.caption ?? ""}
            aria-label={`View ${img.alt}`}
          >
            <img
              src={img.image}
              alt={img.alt}
              loading={i < 6 ? "eager" : "lazy"}
              class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </button>
        ))}
      </div>
    )}
  </section>

  <Lightbox />
</Base>

<style>
  .gallery-grid {
    column-gap: 1rem;
    column-count: 1;
  }
  @media (min-width: 640px) {
    .gallery-grid { column-count: 2; }
  }
  @media (min-width: 1024px) {
    .gallery-grid { column-count: 3; }
  }
  .gallery-grid__item {
    break-inside: avoid;
  }
</style>
